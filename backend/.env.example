# OpenStock API — copy to .env and fill in the keys you have.
# Every key is optional: without keys OpenStock still works from yfinance + cache.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
OPENROUTER_API_KEY=
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=

ALPHAVANTAGE_DAILY_CAP=20
LLM_DAILY_CAP=100
OPENSTOCK_REFRESH_SECONDS=300
# live | fixtures
OPENSTOCK_PROVIDER_MODE=live
